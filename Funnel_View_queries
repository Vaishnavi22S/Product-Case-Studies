-- 1. Clear out the old view configuration
DROP VIEW IF EXISTS vw_funnel_analysis;

-- 2. Build the optimized Customer Lifecycle View
CREATE VIEW vw_funnel_analysis AS
SELECT 
    *, 
    
    -- Clean up missing values (NULLs) with safe fallbacks
    COALESCE(pages_per_session, 0) AS cleaned_pages,
    COALESCE(social_media_engagement_score, 0) AS cleaned_social_score,
    COALESCE(payment_method_diversity, 1) AS cleaned_payment_diversity,

    -- Keep your excellent Friction Tiering logic
    CASE 
        WHEN customer_service_calls > 5 THEN 'High Friction'
        WHEN customer_service_calls <= 2 THEN 'Low Friction'
        ELSE 'Neutral'
    END AS friction_tier,

    -- Updated Lifecycle Funnel Logic (Checking status and activity)
    CASE 
        WHEN Churned = 1 THEN 'Stage 1: Churned / Lost'
        WHEN Days_Since_Last_Purchase > 60 THEN 'Stage 2: Dormant (At-Risk)'
        WHEN Total_Purchases < 10 THEN 'Stage 3: Standard Active'
        WHEN Total_Purchases <= 20 THEN 'Stage 4: High-Value Core'
        ELSE 'Stage 5: Loyal Champion'
    END AS funnel_stage

FROM ecommerce_customer_churn_dataset;